[resource]
script = ExtResource("3_gay7b")
presents = Array[ExtResource("2_sn6if")]([SubResource("Resource_tajeg"), SubResource("Resource_6trht"), SubResource("Resource_swnqu"), SubResource("Resource_ne04h")])
wrappings = Array[ExtResource("4_pl6gh")]([SubResource("Resource_fhf25"), SubResource("Resource_q40rd"), SubResource("Resource_sc0kv"), SubResource("Resource_4t5gk")])
children = Array[ExtResource("1_b4tps")]([SubResource("Resource_iq4y5"), SubResource("Resource_xnuyl"), SubResource("Resource_noih4"), SubResource("Resource_qfiul")])
hints = Array[String](["Either Travis or Ashley wants a red present box, I can't seem to remember", "My note says that Travis likes to play video games, but I can't make out if it says mobile games or console games", "My daugther in law said one of the children wants a phone in a gold present box, but I don't remember which child it was", "My note indicates that Ashley wants a phone... or does this say guitar?", "I'm pretty sure Oli still likes to play music, or does he prefer to listen to music instead?", "I know that the gaming console should be in a red present box", "Neither Mable nor Oli likes the colour green"])
dialog = Array[String](["*Another five years later*", "What? It's Christmas already?", "I can't seem to keep track of the date.", "Ah, the presents are already here—but wait, when did I even get them?", "No matter, now I have to assign the presents to each of my grandchildren.", "My daughter in law wrote me a note to help me with that, but my eyesight seems to have worsened—I can't read most of it.", "I guess I still need to rely on this old brain of mine to remember what my grandchildren want."])
num_children = 4
metadata/_custom_type_script = "uid://bsul2uc068mgc"
